# API auth
API_KEY=your-api-key
AGENT_API_KEY=your-agent-api-key

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
URKLIST_USER_ID=<mongodb-object-id-from-urk-user>

# Backblaze B2 (for newsletter screenshot storage)
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=urklist
# Optional
# B2_AUTH_BASE_URL=https://api.backblazeb2.com

# Gmail OAuth
GMAIL_USER=you@example.com
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Optional LLM config (Ollama/OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_API_KEY=ollama
LLM_TIMEOUT_MS=120000
DISCOVERY_SOURCE=ollama
DISCOVERY_STRICT_LLM=false
CATEGORIZER_BATCH_SIZE=2
CATEGORIZER_DISABLE_BATCH=true
DISCOVERY_LLM_MAX_RETURN=3
DISCOVERY_ENABLE_MILLED=false
DISCOVERY_MILLED_STOP_ON_403=true
DISCOVERY_MILLED_MAX_QUERIES=15
DISCOVERY_AVOID_LIST_MAX=60
DISCOVERY_EXCLUDE_DOMAINS=apple.com,tesla.com,nike.com,dyson.com
DISCOVERY_POOL_ENABLED=true
DISCOVERY_POOL_TARGET_SIZE=1000
DISCOVERY_POOL_FILL_BATCH=12
DISCOVERY_POOL_MAX_CALLS_PER_RUN=3
DISCOVERY_POOL_REFILL_ON_EXHAUST=true
DISCOVERY_POOL_REFILL_BURST_MAX_CALLS=120
DISCOVERY_POOL_HIGH_QUALITY_ONLY=true
CATEGORIZER_BATCH_SIZE=8

# Logo storage (non-LLM)
# provider: local | github
LOGO_STORAGE_PROVIDER=github
GITHUB_LOGO_OWNER=your-github-username-or-org
GITHUB_LOGO_REPO=your-logo-storage-repo
GITHUB_LOGO_BRANCH=main
GITHUB_LOGO_PATH_PREFIX=brand-logos
GITHUB_LOGO_TOKEN=your-github-token-with-repo-contents-write
# Optional override (otherwise jsDelivr GitHub CDN URL is used)
# GITHUB_LOGO_PUBLIC_BASE_URL=https://raw.githubusercontent.com/<owner>/<repo>/<branch>

# Runtime
PORT=3000
NODE_ENV=development
WAIT_FOR_CONFIRMATION_INLINE=false

# Internal scheduler (runs cycle without external cron)
INTERNAL_CRON_ENABLED=true
INTERNAL_CRON_INTERVAL_MIN=10
INTERNAL_CRON_INITIAL_DELAY_SEC=30
INTERNAL_CRON_BATCH_SIZE=10
INTERNAL_CRON_DISCOVER_EVERY_CYCLES=1
INTERNAL_CRON_INBOX_HOURS=24
INTERNAL_CRON_MAX_INBOX_RESULTS=100
INTERNAL_CRON_STEP_LIMIT=50
# Per-step safety guards (prevents stuck jobs from blocking ingestion forever)
INTERNAL_CRON_STEP_TIMEOUT_MIN=12
INTERNAL_CRON_STEP_TIMEOUT_MIN_INGEST_NEWSLETTERS=12
INTERNAL_CRON_STEP_TIMEOUT_MIN_RETRY_MISSING_SCREENSHOTS=8
INTERNAL_CRON_STEP_LOCK_TTL_MIN=30

# One-time full history inbox reconciliation
SCAN_FULL_MAX_RESULTS=0
SCAN_FULL_PAGE_SIZE=500
# Optional override, defaults to: to:${GMAIL_USER} in:inbox
SCAN_FULL_QUERY=

# Optional link destination resolution snapshots
LINK_RESOLUTION_ENABLED=false
LINK_RESOLUTION_MAX_LINKS=5
LINK_RESOLUTION_TIMEOUT_MS=5000

# Brand resolver confidence gate (content/inferred matches)
BRAND_MATCH_CONFIDENCE_THRESHOLD=9

# External sender alias promotion (e.g. brand mail via ESP domains)
EXTERNAL_SENDER_PROMOTION_MIN_COUNT=3
ALLOW_EXTERNAL_SENDER_DOMAIN_PROMOTION=false
EXTERNAL_SENDER_DOMAIN_PROMOTION_MIN_COUNT=6
